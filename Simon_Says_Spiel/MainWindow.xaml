                                <GradientStop Color="#33226D60" Offset="0.601"/>
                                <GradientStop Color="#334DA898" Offset="0.22"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- AI Frame -->
                    <Image Margin="282,-32,281,173" Source="assets/ai_frame.png" Stretch="Fill" IsEnabled="False"/>

                    <!-- Bildschirm -->
                    <Image Margin="322,343,321,0" Source="/assets/player_frame.png" Stretch="Fill" OpacityMask="Black"/>
                    
                    <!-- Textblock Bildschirm -->
                    <TextBlock x:Name="text_block" HorizontalAlignment="Left" Margin="351,418,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="83" Width="294" FontSize="36" TextAlignment="Center" Text="Press Space" FontFamily="OCR A Extended" FontWeight="Bold">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#FF00FF03" Opacity="0.4"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    
                    <!-- Sound Button -->
                    <Button x:Name="sound_btn" Style="{DynamicResource ButtonStyle2}" Content="" HorizontalAlignment="Left" Margin="8,5,0,0" VerticalAlignment="Top" Width="28" Height="27" BorderThickness="0,0,0,0" Click="sound_btn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/assets/sound.png"/>
                        </Button.Background>
                    </Button>
                    
                    <!-- Level Anzeige -->
                    <TextBlock x:Name="level_block" HorizontalAlignment="Left" Margin="355,382,0,0" TextWrapping="Wrap" Text="Level: 1" VerticalAlignment="Top" FontSize="28" Width="285" FontFamily="OCR A Extended" FontWeight="Bold" TextAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#FFBD0000" Opacity="0.8"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    
                    <!-- Textblock Player links -->
                    <TextBlock x:Name="text_block_player_1" HorizontalAlignment="Left" Margin="354,501,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="23" Width="140" FontWeight="Bold" FontFamily="OCR A Extended" FontSize="18" Foreground="#FFEF0909"/>
                    
                    <!-- Textblock Player rechts -->
                    <TextBlock x:Name="text_block_player_2" HorizontalAlignment="Left" Margin="499,501,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="23" Width="139" FontSize="18" FontWeight="Bold" TextAlignment="Right" FontFamily="OCR A Extended" Foreground="#FFEF0909"/>
                    
                    <!-- Start Button -->
                    <Button Style="{DynamicResource ButtonStyle1}" x:Name="start_btn" Content="" HorizontalAlignment="Center" Margin="0,114,0,0" VerticalAlignment="Top" Height="134" Width="132" Click="Button_Click" BorderThickness="0,0,0,0" Opacity="0.85">
                        <Button.Background>
                            <ImageBrush ImageSource="assets/play.png"/>
                        </Button.Background>
                    </Button>
                    
                    <!-- Button "Fenster Schliessen" -->
                    <Button Style="{DynamicResource ButtonStyle1}" x:Name="close_button" Content="" HorizontalAlignment="Left" Margin="954,7,0,0" VerticalAlignment="Top" Width="30" Height="30" BorderThickness="0,0,0,0" Click="close_button_Click" Opacity="0.6">
                        <Button.Background>
                            <ImageBrush ImageSource="/assets/x_light.png">
                                <ImageBrush.RelativeTransform>
                                    <TransformGroup>
                                        <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="2.55" ScaleY="2.55"/>
                                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                                        <RotateTransform CenterY="0.5" CenterX="0.5"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </ImageBrush.RelativeTransform>
                            </ImageBrush>
                        </Button.Background>
                    </Button>
                </Grid>
            </Border>
        </Border>
    </Border>
</Window>

